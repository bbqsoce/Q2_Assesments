        "from typing import Union\n",
        "\n",
        "# ==========================================\n",
        "# MODULE 1: Function Definitions\n",
        "# ==========================================\n",
        "\n",
        "def add_numbers(num1: float, num2: float) -> float:\n",
        "    \"\"\"Calculates and returns the sum of two numbers.\"\"\"\n",
        "    return num1 + num2\n",
        "\n",
        "\n",
        "def subtract_numbers(num1: float, num2: float) -> float:\n",
        "    \"\"\"Calculates and returns the difference of two numbers.\"\"\"\n",
        "    return num1 - num2\n",
        "\n",
        "\n",
        "def multiply_numbers(num1: float, num2: float) -> float:\n",
        "    \"\"\"Calculates and returns the product of two numbers.\"\"\"\n",
        "    return num1 * num2\n",
        "\n",
        "\n",
        "def divide_numbers(num1: float, num2: float) -> float:\n",
        "    \"\"\"\n",
        "    Calculates and returns the quotient of two numbers.\n",
        "    Explicitly raises a ZeroDivisionError if the divisor is 0.\n",
        "    \"\"\"\n",
        "    if num2 == 0:\n",
        "        raise ZeroDivisionError(\"Cannot divide by zero.\")\n",
        "    return num1 / num2\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# MODULE 2: Main Program Implementation\n",
        "# ==========================================\n",
        "\n",
        "def run_calculator() -> None:\n",
        "    print(\"--- Modular Calculator Mini-Program ---\")\n",
        "\n",
        "    # 1. Input: Ask the user to enter two numbers with error handling\n",
        "    try:\n",
        "        first_number: float = float(input(\"Enter first number: \"))\n",
        "        second_number: float = float(input(\"Enter second number: \"))\n",
        "    except ValueError:\n",
        "        print(\"\\nError: Please enter valid numeric values.\")\n",
        "        return\n",
        "\n",
        "    # 2. Input: Ask the user to choose an operation\n",
        "    print(\"\\nChoose operation:\")\n",
        "    print(\"1 - Addition\")\n",
        "    print(\"2 - Subtraction\")\n",
        "    print(\"3 - Multiplication\")\n",
        "    print(\"4 - Division\\n\")\n",
        "\n",
        "    choice: str = input(\"Enter choice: \")\n",
        "\n",
        "    # Map the selections to their corresponding functions\n",
        "    operations = {\n",
        "        '1': add_numbers,\n",
        "        '2': subtract_numbers,\n",
        "        '3': multiply_numbers,\n",
        "        '4': divide_numbers\n",
        "    }\n",
        "\n",
        "    if choice not in operations:\n",
        "        print(\"\\nInvalid choice selected.\")\n",
        "        return\n",
        "\n",
        "    # 3. Process & 4. Output: Safeguarded execution block\n",
        "    try:\n",
        "        # Run the chosen math function using the numbers as arguments\n",
        "        result: float = operations[choice](first_number, second_number)\n",
        "\n",
        "        # Formats the float to remove trailing binary issues (e.g., 0.30000004 -> 0.3)\n",
        "        print(f\"\\nResult: {result:g}\")\n",
        "\n",
        "    except ZeroDivisionError:\n",
        "        # SPECIFIC HANDLER: Catches division by zero instantly and outputs the string cleanly\n",
        "        print(\"\\nResult: Cannot divide by zero.\")\n",
        "\n",
        "\n",
        "# Standard Python boilerplate for clean script execution\n",
        "if __name__ == \"__main__\":\n",
        "    run_calculator()\n"
      ]
